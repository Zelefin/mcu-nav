CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# ESP32-S3 DevKitC exposes the native USB Serial/JTAG port as /dev/cu.usbmodem*.
# Make it the primary console so the USB-serial control channel supports both
# stdout snapshots and stdin JSON commands.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
